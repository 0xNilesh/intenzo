{
  "name": "intenzo",
  "version": "0.0.0",
  "private": true,
  "description": "Proof your PR did what the ticket asked, on video.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:contract": "pnpm -r --if-present test:contract",
    "test:browser": "pnpm -r --if-present test:browser",
    "test:live": "pnpm -r --if-present test:live",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:contract",
    "check:all": "pnpm check && pnpm test:browser",
    "probe:all": "pnpm --filter @intenzo/scripts probe:all",
    "probe:assert": "pnpm --filter @intenzo/scripts probe:assert",
    "gonogo": "pnpm --filter @intenzo/scripts gonogo",
    "github-app:create": "pnpm --filter @intenzo/scripts github-app:create",
    "github-app:sandbox": "pnpm --filter @intenzo/scripts github-app:sandbox",
    "github-app:fixtures": "pnpm --filter @intenzo/scripts github-app:fixtures",
    "demo:ground-truth": "pnpm --filter @intenzo/scripts demo:ground-truth",
    "demo:pm-video": "pnpm --filter @intenzo/scripts demo:pm-video",
    "gate:p0": "pnpm --filter @intenzo/scripts gate:p0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
