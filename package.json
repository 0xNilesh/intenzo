{
  "name": "intenzo",
  "version": "0.0.0",
  "private": true,
  "description": "Proof your PR did what the ticket asked, on video.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:contract": "pnpm -r --if-present test:contract",
    "test:browser": "pnpm -r --if-present test:browser",
    "test:pg": "pnpm -r --if-present test:pg",
    "test:modal": "python3 -m unittest discover -s modal -p 'test_*.py'",
    "test:analysis": "bench/analysis/.venv/bin/python -m pytest -q -p no:cacheprovider bench/analysis",
    "bench:analyze": "bench/analysis/.venv/bin/python bench/analysis/metrics.py && bench/analysis/.venv/bin/python bench/analysis/charts.py",
    "test:live": "pnpm -r --if-present test:live",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:contract && pnpm test:modal",
    "check:all": "pnpm check && pnpm test:browser",
    "probe:all": "pnpm --filter @intenzo/scripts probe:all",
    "probe:assert": "pnpm --filter @intenzo/scripts probe:assert",
    "gonogo": "pnpm --filter @intenzo/scripts gonogo",
    "github-app:create": "pnpm --filter @intenzo/scripts github-app:create",
    "github-app:sandbox": "pnpm --filter @intenzo/scripts github-app:sandbox",
    "github-app:fixtures": "pnpm --filter @intenzo/scripts github-app:fixtures",
    "demo:ground-truth": "pnpm --filter @intenzo/scripts demo:ground-truth",
    "demo:pm-video": "pnpm --filter @intenzo/scripts demo:pm-video",
    "gate:p0": "pnpm --filter @intenzo/scripts gate:p0",
    "gate:p1": "pnpm --filter @intenzo/scripts gate:p1",
    "gate:p2": "pnpm --filter @intenzo/scripts gate:p2",
    "gate:p3": "pnpm --filter @intenzo/scripts gate:p3",
    "gate:p4": "pnpm --filter @intenzo/scripts gate:p4",
    "gate:p5": "pnpm --filter @intenzo/scripts gate:p5",
    "gate:p6": "pnpm --filter @intenzo/scripts gate:p6",
    "bench:validate": "pnpm --filter @intenzo/intentbench validate",
    "bench:record": "pnpm --filter @intenzo/intentbench record",
    "bench:judge": "pnpm --filter @intenzo/intentbench judge",
    "db:generate": "pnpm --filter @intenzo/cloud db:generate",
    "db:migrate": "pnpm --filter @intenzo/cloud db:migrate",
    "repo:secrets": "pnpm --filter @intenzo/cloud repo:secrets",
    "intenzo": "node apps/worker/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
