# Copy to .env (gitignored) and fill in. Used by live tests and the model probes (pnpm probe:all).
# Never commit real keys.

# Meta Model API key (dev.meta.ai). Muse Code reads the same variable.
META_API_KEY=

# Muse Spark Open host. Default: Baseten Model APIs with this key.
BASETEN_API_KEY=

# Or any other OpenAI-compatible host (e.g. Fireworks): set both instead of BASETEN_API_KEY.
# SPARK_OPEN_BASE_URL=https://api.fireworks.ai/inference/v1
# SPARK_OPEN_API_KEY=

# Optional: the Spark Open model id (default: discovered from the host's GET /models).
# SPARK_OPEN_MODEL=meta-models/muse-spark-open                 # Baseten
# SPARK_OPEN_MODEL=accounts/fireworks/models/muse-spark-open    # Fireworks

# Optional: calls per capability (default 1, to save credits; use 5 for a meaningful latency p50).
# PROBE_SAMPLES=5

# demo-shop (sumithprabhu/demo-shop): its test-hook secret (the Vercel Preview value of
# INTENZO_HOOK_SECRET) and Vercel's "Protection Bypass for Automation" secret, for
# `pnpm demo:ground-truth` and, later, local recordings of its previews.
DEMO_SHOP_HOOK_SECRET=
DEMO_SHOP_BYPASS_SECRET=
