{
  "name": "@intenzo/intentbench",
  "version": "0.0.0",
  "private": true,
  "description": "IntentBench: record-once, judge-many benchmark for intent verification.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:contract": "vitest run --project contract --passWithNoTests",
    "test:browser": "vitest run --project browser --passWithNoTests",
    "validate": "node src/validate.ts",
    "record": "node src/record.ts"
  },
  "dependencies": {
    "@intenzo/core": "workspace:*",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  }
}
