{
  "name": "@intenzo/scripts",
  "version": "0.0.0",
  "private": true,
  "description": "Developer scripts: model capability probes, go/no-go and demo tooling.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p gates",
    "test": "vitest run --project unit",
    "test:contract": "vitest run --project contract --passWithNoTests",
    "test:browser": "vitest run --project browser --passWithNoTests",
    "probe:all": "node probe/run.ts",
    "probe:assert": "node probe/assert.ts",
    "gonogo": "node gonogo/run.ts",
    "github-app:create": "node github-app/create-app.ts",
    "github-app:sandbox": "node github-app/sandbox.ts",
    "github-app:fixtures": "node github-app/deliveries.ts",
    "demo:ground-truth": "node demo/ground-truth.ts",
    "demo:pm-video": "node demo/pm-video.ts",
    "gate:p0": "node gates/p0.ts",
    "gate:p1": "node gates/p1.ts",
    "gate:p2": "node gates/p2.ts"
  },
  "dependencies": {
    "@intenzo/core": "workspace:*",
    "pg": "8.23.1",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  }
}
