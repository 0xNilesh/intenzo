{
  "name": "@intenzo/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Verification worker (runs on Modal) and the local intenzo CLI.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:contract": "vitest run --project contract --passWithNoTests",
    "test:browser": "vitest run --project browser --passWithNoTests"
  },
  "dependencies": {
    "@intenzo/core": "workspace:*",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  }
}
