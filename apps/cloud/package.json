{
  "name": "@intenzo/cloud",
  "version": "0.0.0",
  "private": true,
  "description": "Intenzo Cloud: GitHub webhooks, run orchestration, outbox and report pages (Next.js on Vercel).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:contract": "vitest run --project contract --passWithNoTests",
    "test:browser": "vitest run --project browser --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@intenzo/core": "workspace:*",
    "@vercel/functions": "3.10.5",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "msw": "3.0.3",
    "vitest": "5.0.5"
  }
}
