{
  "name": "@intenzo/cloud",
  "version": "0.0.0",
  "private": true,
  "description": "Intenzo Cloud: GitHub webhooks, run orchestration, outbox and report pages (Next.js on Vercel).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:contract": "vitest run --project contract --passWithNoTests",
    "test:browser": "vitest run --project browser --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@intenzo/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "drizzle-kit": "0.31.11",
    "vitest": "5.0.5"
  }
}
